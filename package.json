{
  "name": "opencode-instructions",
  "version": "1.0.0",
  "description": "Edit OpenCode global instructions from Desktop settings",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/47star/opencode-instructions.git"
  },
  "homepage": "https://github.com/47star/opencode-instructions",
  "bugs": "https://github.com/47star/opencode-instructions/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "desktop",
    "instructions",
    "agents-md"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "files": [
    "dist/gui-experimental.cjs",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "vite build",
    "test": "pnpm run build && node --conditions=browser --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run check"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@types/node": "24.19.2",
    "effect": "4.1.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "solid-js": "1.9.19",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-solid": "2.11.16"
  }
}
